{
  "name": "sql-index-simulator-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "tsc --noEmit && vite build",
    "build:gh-pages": "tsc --noEmit && vite build --mode github",
    "build:tauri": "tsc --noEmit && vite build --mode tauri",
    "preview": "vite preview",
    "preview:gh-pages": "vite preview --mode github",
    "lint": "eslint src",
    "lab8": "powershell -ExecutionPolicy Bypass -File ./scripts/lab8-run.ps1",
    "lab8:ip": "powershell -ExecutionPolicy Bypass -File ./scripts/lab8-set-tauri-ip.ps1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.3",
    "@reduxjs/toolkit": "^2.5.0",
    "@tauri-apps/api": "^2.2.0",
    "axios": "^1.7.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.12.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
